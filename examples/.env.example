# Example configuration for a small web app.
# Copy to .env and fill in the values:  cp .env.example .env

# Port the HTTP server listens on.
# @type port
# @required
PORT=8080

# Which deployment this is.
# @values development, staging, production
APP_ENV=development

# Turn on verbose error pages. Never enable in production.
# @type bool
DEBUG=false

# Number of background workers.
# @type int
# @min 1
# @max 32
WORKERS=4

# Public URL of the app, used in emails and redirects.
# @type url
# @required
BASE_URL=http://localhost:8080

# Postgres connection string.
# @type url
# @secret
# @required
DATABASE_URL=

# Token for the payments provider.
# @secret
# @required
PAYMENTS_API_TOKEN=<your-token>

# Address that receives error reports.
# @type email
# @optional
ADMIN_EMAIL=

# Log verbosity.
# @values debug, info, warning, error
LOG_LEVEL=info

# @deprecated use LOG_LEVEL=debug instead
# @optional
VERBOSE=
